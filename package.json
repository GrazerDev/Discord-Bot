{
  "name": "nexus-bot",
  "version": "2.2.0",
  "private": true,
  "description": "A batteries-included Discord bot: moderation, automod, logging, levels, economy, music, tickets, giveaways, reaction roles, suggestions, tags and more.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy:commands": "node src/deploy-commands.js",
    "check": "node scripts/validate.js",
    "test:db": "node scripts/smoke.js",
    "test:cmds": "node scripts/test-commands.js",
    "test": "npm run check && npm run test:db && npm run test:persist && npm run test:cmds && npm run test:tickets",
    "test:persist": "node scripts/test-persist.js",
    "deploy:global": "node src/deploy-commands.js --global",
    "deploy:clear-guild": "node src/deploy-commands.js --clear-guild",
    "deploy:clear-global": "node src/deploy-commands.js --clear-global",
    "test:tickets": "node scripts/test-tickets.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "opusscript": "^0.1.1"
  }
}
