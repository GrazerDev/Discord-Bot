# ─── Required ────────────────────────────────────────────────────────────────
# Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# Developer Portal → your app → General Information → Application ID
DISCORD_CLIENT_ID=

# ─── Recommended while testing ───────────────────────────────────────────────
# Comma separated guild IDs. Commands register instantly here instead of the
# 1-hour global propagation delay. Leave empty to register globally.
GUILD_IDS=

# Your own user ID. Grants owner-only commands (/xp, /unbanall, eval-free stuff).
OWNER_IDS=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Path to the SQLite file. On Railway/Fly/Docker mount a volume and point this
# at it, e.g. /data/bot.db
DB_PATH=./data/bot.db

# ─── Bot presence ────────────────────────────────────────────────────────────
PRESENCE=/help • Nexus
# online | idle | dnd | invisible
PRESENCE_STATUS=online

# ─── Music (optional) ────────────────────────────────────────────────────────
# Set to false to disable the whole music module (commands will explain why).
MUSIC_ENABLED=true
MUSIC_VOLUME=60
MUSIC_MAX_QUEUE=200
# Only change these if the binaries are not on PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# ─── AI chat (optional) ──────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama, ...).
# Leave blank to disable /ai.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ─── Feature switches ────────────────────────────────────────────────────────
FEATURE_LEVELS=true
FEATURE_ECONOMY=true
FEATURE_AUTOMOD=true
